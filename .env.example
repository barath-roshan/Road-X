# ==============================================================================
# RoadX Configuration Template (.env.example)
#
# Copy this file to .env and configure values for your environment.
# NEVER commit the real .env file with production credentials to source control.
# ==============================================================================

# --- Application Environment ---
ROADX_ENV=development
ROADX_LOG_LEVEL=INFO

# --- Directory Path Overrides (Optional - defaults to relative project paths) ---
# ROADX_PROJECT_ROOT=/app
# ROADX_DATA_DIR=/app/data
# ROADX_MODELS_DIR=/app/models
# ROADX_LOGS_DIR=/app/logs

# --- Database Configuration (PostgreSQL / SQLite) ---
# Development default falls back to local SQLite: sqlite:///data/roadx.db
# For production or Docker Compose, set PostgreSQL connection URL:
DATABASE_URL=postgresql://roadx_user:roadx_password@localhost:5432/roadx_db
ROADX_DB_ECHO=false
ROADX_DB_POOL_SIZE=5
ROADX_DB_MAX_OVERFLOW=10

# --- PostgreSQL Container Parameters (Used by Docker Compose) ---
POSTGRES_DB=roadx_db
POSTGRES_USER=roadx_user
POSTGRES_PASSWORD=roadx_password

# --- Container Database Migration Control ---
# When true, container entrypoint automatically executes 'alembic upgrade head' on startup
RUN_MIGRATIONS=true

# --- API & CORS Security ---
# Comma-separated list of allowed origins. Do NOT use wildcard (*) in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000
MAX_IMAGE_SIZE_BYTES=10485760

# --- Notification & SMS Settings (Phase 18) ---
# Notifications enabled by default. Twilio SMS is optional and disabled by default.
NOTIFICATIONS_ENABLED=true
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=your_twilio_account_sid_placeholder
TWILIO_AUTH_TOKEN=your_twilio_auth_token_placeholder
TWILIO_PHONE_NUMBER=+1234567890

# --- Citizen Chatbot & RAG Intelligence (Phase 19) ---
# LLM Provider: 'mock' (default, offline deterministic) or 'groq' (requires API key)
ROADX_LLM_PROVIDER=mock
ROADX_LLM_MODEL=llama3-8b-8192
ROADX_LLM_API_KEY=your_llm_api_key_placeholder
ROADX_LLM_TEMPERATURE=0.2
ROADX_LLM_MAX_TOKENS=500
ROADX_RAG_EMBEDDING_DIM=300
ROADX_RAG_TOP_K=3
ROADX_RAG_MIN_SCORE=0.05

# --- MLflow Experiment Tracking & Monitoring (Phase 21) ---
# Tracks training metrics and inference telemetry. Safe offline fallback if unconfigured.
ROADX_MLFLOW_ENABLED=true
# Local file-backed tracking default: file:///app/models/mlruns
# Remote server example: http://mlflow.internal:5000
ROADX_MLFLOW_TRACKING_URI=file:///app/models/mlruns
ROADX_MLFLOW_EXPERIMENT=RoadX_Failure_Prediction
ROADX_MLFLOW_REGISTERED_MODEL=RoadX_Spatiotemporal_Model
